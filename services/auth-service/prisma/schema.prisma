// prisma/schema.prisma

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}


enum Gender {
  MALE
  FEMALE
}

model tbl_users {
  user_id         String     @id @default(uuid())
  first_name      String
  last_name       String
  user_nid        String?    @unique
  user_phone      String?    @unique
  created_at      DateTime   @default(now())
  user_dob        DateTime?
  user_photo      String?
  user_gender     Gender?
  street_address  String?
  auth_id         String
  tbl_auth        tbl_auth   @relation(fields: [auth_id], references: [auth_id])
}


enum UserStatus {
  ACTIVE
  INACTIVE
  SUSPENDED
}

model tbl_auth {
  auth_id     String     @id @default(uuid())
  email       String?    @unique
  password    String?
  updated_at  DateTime?
  user_status UserStatus @default(ACTIVE)
  tbl_users   tbl_users[] // Reference only, not owned here
}