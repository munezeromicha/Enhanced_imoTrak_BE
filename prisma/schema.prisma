generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model tbl_auth {
  auth_id                            String     @id @default(uuid())
  email                              String?    @unique
  password                           String?
  updated_at                         DateTime?
  user_status                        UserStatus @default(ACTIVE)
  is_verified                        Boolean    @default(false)
  /// Stable Inuma subject (`sub`). Used to find SSO users if email changes.
  sso_sub                            String?    @unique
  /// Latest Inuma position name from SSO / public API.
  inuma_position                     String?
  /// Latest Inuma campus / unit name from SSO / public API.
  inuma_unit                         String?
  inuma_campus_code                  String?
  /// ImoTrak unit matched from Inuma campus catalog.
  matched_unit_id                    String?
  /// ImoTrak position matched or proposed from Inuma position catalog.
  matched_position_id                String?
  imotrak_access_approved_at         DateTime?
  imotrak_access_approved_by_user_id String?
  user                               tbl_users?
}

model tbl_users {
  user_id                    String                                @id @default(uuid())
  first_name                 String
  last_name                  String
  user_nid                   String                                @unique
  user_phone                 String                                @unique
  created_at                 DateTime                              @default(now())
  user_dob                   DateTime
  user_photo                 String?
  /// Scanned or drawn signature, stamped onto documents this person signs.
  signature_url              String?
  user_gender                Gender
  street_address             String?
  auth_id                    String                                @unique
  updated_by_user_id         String?
  audit_logs                 tbl_audit_logs[]
  blacklisted_tokens         tbl_jwt_blacklist[]
  notifications              tbl_notifications[]
  reservations_approved      tbl_reservations[]                    @relation("ReservationApprover")
  reservations_canceled      tbl_reservations[]                    @relation("ReservationCanceler")
  reservations_completed     tbl_reservations[]                    @relation("ReservationCompleter")
  reservations_reviewed      tbl_reservations[]                    @relation("ReservationReviewer")
  reservations               tbl_reservations[]                    @relation("ReservationUser")
  reserved_vehicles_returned tbl_reserved_vehicles[]               @relation("ReservationReturnedBy")
  auth                       tbl_auth                              @relation(fields: [auth_id], references: [auth_id])
  updater_issues             tbl_vehicle_issues[]                  @relation("VehicleIssueUpdater")
  driver                     tbl_drivers?
  reported_issues            tbl_vehicle_issues[]                  @relation("UserReportedIssues")
  issue_replies              tbl_vehicle_issue_replies[]
  position_assignments       tbl_user_position_assignments[]
  maintenance_created        tbl_vehicle_maintenance[]             @relation("MaintenanceCreatedBy")
  maintenance_supervisions   tbl_vehicle_maintenance_supervisors[]
}

model tbl_audit_logs {
  id         String    @id @default(uuid())
  user_id    String
  action     String
  table_name String?
  record_id  String?
  old_value  Json?
  new_value  Json?
  timestamp  DateTime  @default(now())
  ip_address String
  user_agent String
  user       tbl_users @relation(fields: [user_id], references: [user_id])

  @@index([user_id])
  @@index([table_name])
  @@index([record_id])
}

model tbl_notifications {
  notification_id      String    @id @default(uuid())
  user_id              String
  notification_title   String
  notification_message String
  is_read              Boolean   @default(false)
  created_at           DateTime  @default(now())
  user                 tbl_users @relation(fields: [user_id], references: [user_id])
}

model tbl_organizations {
  organization_id       String                  @id @default(uuid())
  organization_name     String                  @unique
  street_address        String
  organization_phone    String                  @unique
  organization_email    String                  @unique
  organization_logo     String
  created_at            DateTime                @default(now())
  organization_customId String                  @unique
  organization_status   OrgStatus               @default(ACTIVE)
  uses_reservations     Boolean                 @default(true)
  leader_unit_id        String?
  leader_position_id    String?
  units                 tbl_unit[]
  vehicles              tbl_vehicles[]
  vehicle_types         tbl_vehicle_types[]
  generators            tbl_generators[]
  fuel_requisitions     tbl_fuel_requisitions[]
  fuel_transactions     tbl_fuel_transactions[]
}

model tbl_reservations {
  reservation_id          String                  @id @default(uuid())
  created_at              DateTime                @default(now())
  reservation_purpose     String
  start_location          String
  reservation_destination String
  departure_date          DateTime
  expected_returning_date DateTime
  reservation_status      RequestStatus           @default(UNDER_REVIEW)
  reviewed_at             DateTime?
  rejection_comment       String?
  user_id                 String
  /// The requesting unit, captured when the reservation is raised.
  ///
  /// A reservation has no vehicle until it is approved, so this is the only
  /// unit signal available at creation. Null on rows that predate the column,
  /// or whose requester held positions in more than one unit; null reads as
  /// organization-level rather than hidden.
  unit_id                 String?
  description             String                  @default("")
  passengers              Int                     @default(0)
  approved_at             DateTime?
  approved_by             String?
  canceled_at             DateTime?
  canceled_by             String?
  completed_at            DateTime?
  completed_by            String?
  reviewed_by             String?
  unit                    tbl_unit?               @relation(fields: [unit_id], references: [unit_id])
  approver                tbl_users?              @relation("ReservationApprover", fields: [approved_by], references: [user_id])
  canceler                tbl_users?              @relation("ReservationCanceler", fields: [canceled_by], references: [user_id])
  completer               tbl_users?              @relation("ReservationCompleter", fields: [completed_by], references: [user_id])
  reviewer                tbl_users?              @relation("ReservationReviewer", fields: [reviewed_by], references: [user_id])
  user                    tbl_users               @relation("ReservationUser", fields: [user_id], references: [user_id])
  reserved_vehicles       tbl_reserved_vehicles[]

  @@index([unit_id])
}

model tbl_vehicle_models {
  vehicle_model_id   String         @id @default(uuid())
  vehicle_model_name String         @unique
  // Was the VehicleType enum; now a free string validated against
  // tbl_vehicle_types so organisations can define their own types.
  vehicle_type       String
  manufacturer_name  String
  created_at         DateTime       @default(now())
  vehicle_capacity   Int            @default(0)
  vehicles           tbl_vehicles[]
}

/// Manageable list of vehicle types. Rows with organization_id = null are the
/// built-in defaults available to every organisation; a non-null organization_id
/// is a type that organisation added for itself.
model tbl_vehicle_types {
  vehicle_type_id String   @id @default(uuid())
  name            String
  is_default      Boolean  @default(false)
  organization_id String?
  created_at      DateTime @default(now())

  organization tbl_organizations? @relation(fields: [organization_id], references: [organization_id])

  // A type name is unique within an org (and unique among globals where org is null).
  @@unique([name, organization_id])
  @@index([organization_id])
}

model tbl_vehicles {
  vehicle_id        String                    @id @default(uuid())
  plate_number      String                    @unique
  transmission_mode TransmissionMode
  vehicle_model_id  String
  vehicle_photo     String
  vehicle_year      Int
  vehicle_status    VehicleStatus             @default(AVAILABLE)
  energy_type       String
  // Odometer reading at registration. Seeds the first trip's starting odometer;
  // afterwards each trip's starting odometer chains from the previous trip's
  // returned odometer (see getNextStartingOdometer).
  current_odometer  Int                       @default(0)
  last_service_date DateTime                  @default(now())
  created_at        DateTime                  @default(now())
  organization_id   String
  unit_id           String?
  reservations      tbl_reserved_vehicles[]
  organization      tbl_organizations         @relation(fields: [organization_id], references: [organization_id])
  vehicle_model     tbl_vehicle_models        @relation(fields: [vehicle_model_id], references: [vehicle_model_id])
  unit              tbl_unit?                 @relation(fields: [unit_id], references: [unit_id])
  locations         tbl_vehicle_locations[]
  gps_device        tbl_gps_devices?
  maintenance       tbl_vehicle_maintenance[]
  fuel_requisitions tbl_fuel_requisitions[]
}

model tbl_reserved_vehicles {
  reserved_vehicle_id  String                         @id @default(uuid())
  vehicle_id           String
  reservation_id       String
  created_at           DateTime                       @default(now())
  starting_odometer    Int
  returned_odometer    Int?
  returned_fuel_energy Int?
  fuel_provided        Int?
  returned_date        DateTime?
  returned_by          String?
  reservation          tbl_reservations               @relation(fields: [reservation_id], references: [reservation_id])
  returned_by_user     tbl_users?                     @relation("ReservationReturnedBy", fields: [returned_by], references: [user_id])
  vehicle              tbl_vehicles                   @relation(fields: [vehicle_id], references: [vehicle_id])
  isuues               tbl_vehicle_issues[]
  locations            tbl_vehicle_locations[]
  replaced_by_id       String?                        @unique
  replaced_by          tbl_reserved_vehicles?         @relation("VehicleReplacement", fields: [replaced_by_id], references: [reserved_vehicle_id])
  replacement_for      tbl_reserved_vehicles?         @relation("VehicleReplacement")
  drivers              tbl_reserved_vehicle_drivers[]
  issue_replacements   tbl_vehicle_issues[]           @relation("IssueReplacementReservedVehicle")
}

model tbl_vehicle_locations {
  location_id         String                 @id @default(uuid())
  vehicle_id          String
  reserved_vehicle_id String?
  coords              Json
  timestamp           DateTime               @default(now())
  vehicle             tbl_vehicles           @relation(fields: [vehicle_id], references: [vehicle_id])
  reserved_vehicle    tbl_reserved_vehicles? @relation(fields: [reserved_vehicle_id], references: [reserved_vehicle_id])
}

model tbl_unit {
  unit_id           String                  @id @default(uuid())
  unit_name         String
  created_at        DateTime                @default(now())
  organization_id   String
  status            OrgStatus               @default(ACTIVE)
  is_primary        Boolean                 @default(false)
  positions         tbl_position[]
  vehicles          tbl_vehicles[]
  organization      tbl_organizations       @relation(fields: [organization_id], references: [organization_id])
  generators        tbl_generators[]
  fuel_requisitions tbl_fuel_requisitions[]
  reservations      tbl_reservations[]

  @@unique([unit_name, organization_id])
}

model tbl_position {
  position_id          String                          @id @default(uuid())
  position_name        String
  position_description String
  position_access      Json
  created_at           DateTime                        @default(now())
  unit_id              String
  position_status      OrgStatus                       @default(ACTIVE)
  is_org_leader        Boolean                         @default(false)
  unit                 tbl_unit                        @relation(fields: [unit_id], references: [unit_id])
  assignments          tbl_user_position_assignments[]

  @@unique([position_name, unit_id])
}

model tbl_gps_devices {
  gps_device_id    String       @id @default(uuid())
  vehicle_id       String       @unique
  device_model     String       @default("M588GS")
  imei             String       @unique
  sim_number       String?
  phone_number     String?
  apn              String?
  server_ip        String?
  server_port      Int?
  firmware_version String?
  install_date     DateTime?
  notes            String?
  created_at       DateTime     @default(now())
  updated_at       DateTime?
  vehicle          tbl_vehicles @relation(fields: [vehicle_id], references: [vehicle_id], onDelete: Cascade)
}

model tbl_user_position_assignments {
  assignment_id String       @id @default(uuid())
  user_id       String
  position_id   String
  assigned_at   DateTime     @default(now())
  user          tbl_users    @relation(fields: [user_id], references: [user_id], onDelete: Cascade)
  position      tbl_position @relation(fields: [position_id], references: [position_id], onDelete: Cascade)

  @@unique([user_id, position_id])
  @@index([user_id])
  @@index([position_id])
}

model tbl_vehicle_issues {
  issue_id                        String                      @id @default(uuid())
  issue_title                     String
  issue_status                    IssueStatus                 @default(OPEN)
  issue_description               String
  issue_date                      DateTime                    @default(now())
  created_at                      DateTime                    @default(now())
  updated_at                      DateTime?                   @default(now())
  issue_responder                 String?
  reserved_vehicle_id             String
  message                         String?
  updater                         tbl_users?                  @relation("VehicleIssueUpdater", fields: [issue_responder], references: [user_id])
  reserved_vehicle                tbl_reserved_vehicles       @relation(fields: [reserved_vehicle_id], references: [reserved_vehicle_id])
  reported_by_user_id             String?
  reported_by_driver_id           String?
  severity_level                  IssueSeverity               @default(LOW)
  replacement_requested           Boolean                     @default(false)
  replacement_status              String?
  replacement_reserved_vehicle_id String?
  reported_by_user                tbl_users?                  @relation("UserReportedIssues", fields: [reported_by_user_id], references: [user_id])
  reported_by_driver              tbl_drivers?                @relation("DriverReportedIssues", fields: [reported_by_driver_id], references: [driver_id])
  replacement_reserved_vehicle    tbl_reserved_vehicles?      @relation("IssueReplacementReservedVehicle", fields: [replacement_reserved_vehicle_id], references: [reserved_vehicle_id])
  replies                         tbl_vehicle_issue_replies[]
}

model tbl_jwt_blacklist {
  id         String    @id @default(uuid())
  token      String    @unique
  user_id    String
  expires_at DateTime
  created_at DateTime  @default(now())
  user       tbl_users @relation(fields: [user_id], references: [user_id])

  @@index([expires_at])
}

enum UserStatus {
  ACTIVE
  INACTIVE
  SUSPENDED
  PENDING_APPROVAL
}

enum Gender {
  MALE
  FEMALE
}

enum OrgStatus {
  ACTIVE
  INACTIVE
  DELETED
  SUSPENDED
}

enum VehicleStatus {
  AVAILABLE
  OCCUPIED
  MAINTENANCE
  OUT_OF_SERVICE
}

enum TransmissionMode {
  MANUAL
  AUTOMATIC
  SEMI_AUTOMATIC
}

enum RequestStatus {
  UNDER_REVIEW
  CANCELED
  APPROVED
  REJECTED
  IN_PROGRESS
  ON_HOLD
  COMPLETED
  FAILED
  EXPIRED
  ACCEPTED
}

enum PostitionStatus {
  ACTIVE
  INACTIVE
}

enum IssueStatus {
  OPEN
  CLOSED
}

model tbl_contacts {
  contact_id String   @id @default(uuid())
  name       String
  email      String
  message    String
  created_at DateTime @default(now())
  is_read    Boolean  @default(false)
}

model tbl_drivers {
  driver_id        String       @id @default(uuid())
  user_id          String       @unique
  license_number   String       @unique
  license_category String
  experience_years Int
  driver_status    DriverStatus @default(AVAILABLE)
  created_at       DateTime     @default(now())
  updated_at       DateTime     @updatedAt

  user            tbl_users                      @relation(fields: [user_id], references: [user_id])
  assignments     tbl_reserved_vehicle_drivers[]
  replies         tbl_vehicle_issue_replies[]
  reported_issues tbl_vehicle_issues[]           @relation("DriverReportedIssues")
}

model tbl_reserved_vehicle_drivers {
  assignment_id       String    @id @default(uuid())
  reserved_vehicle_id String
  driver_id           String
  assigned_at         DateTime  @default(now())
  is_active           Boolean   @default(true)
  unassigned_at       DateTime?
  created_at          DateTime  @default(now())

  reserved_vehicle tbl_reserved_vehicles @relation(fields: [reserved_vehicle_id], references: [reserved_vehicle_id])
  driver           tbl_drivers           @relation(fields: [driver_id], references: [driver_id])
}

model tbl_vehicle_issue_replies {
  reply_id      String   @id @default(uuid())
  issue_id      String
  user_id       String?
  driver_id     String?
  reply_content String
  created_at    DateTime @default(now())

  issue  tbl_vehicle_issues @relation(fields: [issue_id], references: [issue_id])
  user   tbl_users?         @relation(fields: [user_id], references: [user_id])
  driver tbl_drivers?       @relation(fields: [driver_id], references: [driver_id])
}

/// A single maintenance job on a vehicle (scheduled, in progress, or historical).
model tbl_vehicle_maintenance {
  maintenance_id   String            @id @default(uuid())
  vehicle_id       String
  title            String
  description      String?
  maintenance_type MaintenanceType   @default(CORRECTIVE)
  status           MaintenanceStatus @default(SCHEDULED)

  scheduled_date DateTime?
  started_at     DateTime?
  completed_at   DateTime?

  /// Workshop / garage performing the work.
  service_provider String?
  cost             Decimal? @db.Decimal(12, 2)
  currency         String?  @default("RWF")
  odometer_km      Int?
  /// Free-text summary of what was actually done, filled in on completion.
  work_performed   String?
  cancel_reason    String?

  created_by_user_id String
  created_at         DateTime @default(now())
  updated_at         DateTime @updatedAt

  vehicle     tbl_vehicles                          @relation(fields: [vehicle_id], references: [vehicle_id])
  created_by  tbl_users                             @relation("MaintenanceCreatedBy", fields: [created_by_user_id], references: [user_id])
  supervisors tbl_vehicle_maintenance_supervisors[]

  @@index([vehicle_id])
  @@index([status])
}

/// Who is (or was) leading a maintenance job. Modelled as a history table
/// rather than a single column so a handover keeps the previous supervisor
/// on record — "is or was in control".
model tbl_vehicle_maintenance_supervisors {
  assignment_id  String    @id @default(uuid())
  maintenance_id String
  user_id        String
  /// Exactly one row per maintenance job should have is_active = true.
  is_active      Boolean   @default(true)
  assigned_at    DateTime  @default(now())
  unassigned_at  DateTime?
  /// Why the job changed hands, recorded on the outgoing row.
  handover_note  String?
  created_at     DateTime  @default(now())

  maintenance tbl_vehicle_maintenance @relation(fields: [maintenance_id], references: [maintenance_id], onDelete: Cascade)
  user        tbl_users               @relation(fields: [user_id], references: [user_id])

  @@index([maintenance_id])
  @@index([user_id])
}

enum MaintenanceStatus {
  SCHEDULED
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

enum MaintenanceType {
  PREVENTIVE
  CORRECTIVE
  INSPECTION
  REPAIR
  TIRE
  BODYWORK
  OTHER
}

enum DriverStatus {
  AVAILABLE
  ON_TRIP
  INACTIVE
}

enum IssueSeverity {
  LOW
  MEDIUM
  HIGH
  CRITICAL
  DANGER
}

// ---------------------------------------------------------------------------
// Fuel management
//
// Mirrors the University of Rwanda paper trail: a fuel requisition is raised by
// a driver (or a generator custodian), recommended by Assets and Services
// Management, funded by the Director of Finance, then issued and signed for at
// the logistics desk. Every issue posts to a running fuel account so the
// monthly consumption report reconciles against replenishments.
// ---------------------------------------------------------------------------

enum FuelRequestType {
  VEHICLE
  GENERATOR
}

enum FuelRequisitionStatus {
  SUBMITTED
  RECOMMENDED
  FUNDING_CONFIRMED
  ISSUED
  RECEIVED
  REJECTED
  CANCELLED
}

enum FuelTransactionType {
  OPENING_BALANCE
  REPLENISHMENT
  ISSUE
  ADJUSTMENT
}

/// A standby generator that draws from the same fuel account as the fleet.
/// It has no odometer, so consumption is tracked against a gauge percentage.
model tbl_generators {
  generator_id       String    @id @default(uuid())
  generator_name     String
  generator_code     String?
  location           String?
  organization_id    String
  unit_id            String?
  /// Last recorded gauge reading, 0-100.
  fuel_level_percent Int?
  status             OrgStatus @default(ACTIVE)
  created_at         DateTime  @default(now())
  updated_at         DateTime  @updatedAt

  organization tbl_organizations       @relation(fields: [organization_id], references: [organization_id])
  unit         tbl_unit?               @relation(fields: [unit_id], references: [unit_id])
  requisitions tbl_fuel_requisitions[]

  @@unique([generator_name, organization_id])
  @@index([organization_id])
}

/// One filled-in fuel requisition form, carried through its four sections.
///
/// The people who sign each section are stored as an id *plus* a name and
/// position snapshot rather than as foreign keys. The snapshot is the record of
/// who signed at the time, and must not follow someone who later changes
/// position or leaves — the same reason the paper form asks for the name and
/// position next to every signature.
model tbl_fuel_requisitions {
  fuel_requisition_id String                @id @default(uuid())
  /// Human-readable number used on printouts, e.g. FR-2026-000042.
  reference           String                @unique
  organization_id     String
  unit_id             String?
  request_type        FuelRequestType
  status              FuelRequisitionStatus @default(SUBMITTED)

  vehicle_id   String?
  generator_id String?
  /// Plate number or generator name as it stood when the form was raised, so
  /// the consumption report stays readable if the asset is renamed or removed.
  asset_label  String

  // I. Applicant details
  applicant_user_id         String
  applicant_name            String
  applicant_position        String?
  applicant_signature_url   String?
  quantity_requested_litres Decimal  @db.Decimal(10, 2)
  /// Logbook reading in km. Vehicles only.
  odometer_km               Int?
  /// Gauge reading as a percentage. Generators only.
  fuel_indicator_percent    Int?
  purpose                   String
  requested_at              DateTime @default(now())

  // II. Recommending authority (Assets and Services Management)
  recommended_by_user_id       String?
  recommended_by_name          String?
  recommended_by_position      String?
  recommended_by_signature_url String?
  recommended_at               DateTime?
  recommendation_note          String?

  // III. Confirmation of funding (Director of Finance)
  funding_confirmed_by_user_id       String?
  funding_confirmed_by_name          String?
  funding_confirmed_by_position      String?
  funding_confirmed_by_signature_url String?
  funding_confirmed_at               DateTime?

  // IV. Verification (Logistics)
  issued_by_user_id        String?
  issued_by_name           String?
  issued_by_signature_url  String?
  issued_at                DateTime?
  quantity_supplied_litres Decimal?  @db.Decimal(10, 2)
  amount_rwf               Decimal?  @db.Decimal(12, 2)

  received_by_user_id       String?
  received_by_name          String?
  received_by_signature_url String?
  received_at               DateTime?
  /// Set when the completed fuel is posted to the vehicle or generator's
  /// own history. Marks the requisition as accounted for on the asset, so
  /// nobody has to key the litres in a second time.
  recorded_on_asset_at      DateTime?

  rejected_by_user_id String?
  rejected_by_name    String?
  rejected_at         DateTime?
  rejection_reason    String?

  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  organization tbl_organizations       @relation(fields: [organization_id], references: [organization_id])
  unit         tbl_unit?               @relation(fields: [unit_id], references: [unit_id])
  vehicle      tbl_vehicles?           @relation(fields: [vehicle_id], references: [vehicle_id])
  generator    tbl_generators?         @relation(fields: [generator_id], references: [generator_id])
  transactions tbl_fuel_transactions[]

  @@index([organization_id, status])
  @@index([applicant_user_id])
  @@index([vehicle_id])
  @@index([generator_id])
}

/// The fuel account ledger behind the monthly consumption report.
///
/// `amount_rwf` is signed: opening balance and replenishments are positive,
/// issues negative, so the running balance is a cumulative sum in date order
/// and never needs a stored snapshot to be trusted.
model tbl_fuel_transactions {
  fuel_transaction_id String              @id @default(uuid())
  organization_id     String
  type                FuelTransactionType
  amount_rwf          Decimal             @db.Decimal(14, 2)
  litres              Decimal?            @db.Decimal(10, 2)
  description         String
  occurred_on         DateTime
  fuel_requisition_id String?
  recorded_by_user_id String
  recorded_by_name    String
  created_at          DateTime            @default(now())

  organization tbl_organizations      @relation(fields: [organization_id], references: [organization_id])
  requisition  tbl_fuel_requisitions? @relation(fields: [fuel_requisition_id], references: [fuel_requisition_id])

  @@index([organization_id, occurred_on])
  @@index([fuel_requisition_id])
}
