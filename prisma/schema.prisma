generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model organizations {
  id         String     @id @default(dbgenerated("gen_random_uuid()"))
  name       String
  address    String
  phone      String
  email      String     @unique
  created_at DateTime   @default(now())
  customId   String     @unique
  status     String     @default("Active")
  reports    reports[]
  users      users[]
  vehicles   vehicles[]
}

model permissions {
  id               String             @id @default(uuid())
  name             String             @unique
  description      String?
  role_permissions role_permissions[]
}

model reports {
  id              String        @id @default(uuid())
  generated_by    String
  organization_id String
  report_type     String
  generated_at    DateTime      @default(now())
  file_url        String?
  description     String?
  users           users         @relation(fields: [generated_by], references: [id])
  organizations   organizations @relation(fields: [organization_id], references: [id])
}

model requests {
  id                                 String        @id @default(uuid())
  vehicle_id                         String?
  requested_at                       DateTime      @default(now())
  trip_purpose                       String
  start_location                     String
  end_location                       String
  start_date                         DateTime
  end_date                           DateTime
  status                             RequestStatus @default(PENDING)
  reviewed_at                        DateTime?
  comments                           String?
  requester_id                       String
  reviewed_by                        String?
  full_name                          String
  passengers_number                  Int           @default(1)
  users_requests_requester_idTousers users         @relation("requests_requester_idTousers", fields: [requester_id], references: [id])
  users_requests_reviewed_byTousers  users?        @relation("requests_reviewed_byTousers", fields: [reviewed_by], references: [id])
  vehicles                           vehicles?     @relation(fields: [vehicle_id], references: [id])
  trips                              trips[]
}

model role_permissions {
  id            String      @id @default(uuid())
  role_id       String
  permission_id String
  permissions   permissions @relation(fields: [permission_id], references: [id])
  roles         roles       @relation(fields: [role_id], references: [id])

  @@unique([role_id, permission_id])
}

model roles {
  id               String             @id @default(dbgenerated("gen_random_uuid()"))
  name             String             @unique
  description      String
  role_permissions role_permissions[]
  users            users[]
}

model RoleVisibility {
  id     String @id @default(dbgenerated("gen_random_uuid()"))
  role   String
  canSee String
}

model trips {
  id             String    @id @default(uuid())
  request_id     String?
  vehicle_id     String
  start_odometer Int
  end_odometer   Int?
  start_time     DateTime
  end_time       DateTime?
  fuel_used      Float?
  trip_notes     String?
  created_at     DateTime  @default(now())
  driver_id      String
  users          users     @relation(fields: [driver_id], references: [id])
  requests       requests? @relation(fields: [request_id], references: [id])
  vehicles       vehicles  @relation(fields: [vehicle_id], references: [id])
}

model users {
  id                                    String         @id @default(dbgenerated("gen_random_uuid()"))
  organization_id                       String
  password_hash                         String
  email                                 String         @unique
  phone                                 String?
  status                                String         @default("active")
  created_at                            DateTime       @default(now())
  last_login                            DateTime?
  role_id                               String
  dob                                   DateTime
  first_name                            String
  last_name                             String
  nid                                   String         @unique
  gender                                Gender
  street_address                        String
  reports                               reports[]
  requests_requests_requester_idTousers requests[]     @relation("requests_requester_idTousers")
  requests_requests_reviewed_byTousers  requests[]     @relation("requests_reviewed_byTousers")
  trips                                 trips[]
  organizations                         organizations  @relation(fields: [organization_id], references: [id])
  roles                                 roles          @relation(fields: [role_id], references: [id])
  notifications                         Notifications[]
}

model vehicles {
  id                String        @id @default(uuid())
  plate_number      String        @unique
  vehicle_type      String
  vehicle_model     String
  manufacturer      String?
  year              Int?
  capacity          Int?
  odometer          Int           @default(0)
  status            VehicleStatus @default(AVAILABLE)
  fuel_type         String?
  last_service_date DateTime?
  created_at        DateTime      @default(now())
  organization_id   String
  requests          requests[]
  trips             trips[]
  organizations     organizations @relation(fields: [organization_id], references: [id])
}

enum Gender {
  MALE
  FEMALE
}

enum VehicleStatus {
  AVAILABLE
  OCCUPIED
  MAINTENANCE
  OUT_OF_SERVICE
}

enum RequestStatus {
  PENDING
  APPROVED
  REJECTED
  CANCELLED
}

model Notifications {
  id          String   @id @default(uuid())
  user_id     String
  title       String
  message     String
  type        String
  status      String   @default("UNREAD") // UNREAD | READ
  created_at  DateTime @default(now())
  read_at     DateTime?

  user users @relation(fields: [user_id], references: [id])
}

enum NotificationType {
  SUCCESS
  INFO
  ERROR
}
